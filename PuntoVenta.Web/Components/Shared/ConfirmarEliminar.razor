<Modal Visible="@Visible" Title="Confirmar eliminacion" Size="modal-sm" OnClose="OnCancelar">
    <p class="mb-3">¿Desea eliminar <strong>@Nombre</strong>? Esta accion no se puede deshacer.</p>
    <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-secondary" @onclick="OnCancelar">Cancelar</button>
        <button class="btn btn-danger" @onclick="OnConfirmar"><i class="bi bi-trash"></i> Eliminar</button>
    </div>
</Modal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Nombre { get; set; } = "";
    [Parameter] public EventCallback OnConfirmar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }
}
