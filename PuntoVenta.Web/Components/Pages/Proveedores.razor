@page "/proveedores"
@attribute [Authorize]
@inherits PaginaBase

<PageTitle>Proveedores</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0"><i class="bi bi-truck"></i> Proveedores</h1>
    <div class="d-flex gap-2">
        <a href="/compras" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver a Compras</a>
        <button class="btn btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg"></i> Nuevo proveedor</button>
    </div>
</div>

<Alerta Mensaje="@Mensaje" Tipo="@TipoMensaje" OnCerrar="CerrarMensaje" />

<div class="input-group mb-3">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input class="form-control" placeholder="Buscar por nombre, NIT o correo..."
           @bind="buscar" @bind:event="oninput" @bind:after="Cargar" />
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Proveedor</th><th>NIT</th><th>Telefono</th><th>Correo</th><th>Direccion</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @if (Cargando)
                {
                    <tr><td colspan="7" class="text-center py-4"><div class="spinner-border spinner-border-sm"></div> Cargando...</td></tr>
                }
                else if (items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">No hay proveedores registrados.</td></tr>
                }
                else
                {
                    @foreach (var p in items)
                    {
                        <tr>
                            <td>@p.IdProveedor</td>
                            <td>@p.Nombre</td>
                            <td>@p.Nit</td>
                            <td>@p.Telefono</td>
                            <td>@p.Correo</td>
                            <td>@p.Direccion</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => Editar(p)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => eliminando = p"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<Modal Visible="mostrarForm" Title="@(modelo.IdProveedor == 0 ? "Nuevo proveedor" : "Editar proveedor")" OnClose="Cancelar">
    @if (errorForm is not null)
    {
        <div class="alert alert-danger">@errorForm</div>
    }
    <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Proveedor *</label>
                <InputText class="form-control" @bind-Value="modelo.Nombre" />
                <ValidationMessage For="() => modelo.Nombre" />
            </div>
            <div class="col-md-4">
                <label class="form-label">NIT *</label>
                <InputText class="form-control" @bind-Value="modelo.Nit" />
                <ValidationMessage For="() => modelo.Nit" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Telefono</label>
                <InputText class="form-control" @bind-Value="modelo.Telefono" />
                <ValidationMessage For="() => modelo.Telefono" />
            </div>
            <div class="col-md-8">
                <label class="form-label">Correo electronico</label>
                <InputText type="email" class="form-control" @bind-Value="modelo.Correo" />
                <ValidationMessage For="() => modelo.Correo" />
            </div>
            <div class="col-12">
                <label class="form-label">Direccion</label>
                <InputText class="form-control" @bind-Value="modelo.Direccion" />
                <ValidationMessage For="() => modelo.Direccion" />
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@guardando"><i class="bi bi-save"></i> Guardar</button>
        </div>
    </EditForm>
</Modal>

<ConfirmarEliminar Visible="eliminando is not null" Nombre="@(eliminando?.Nombre ?? "")"
                   OnConfirmar="Eliminar" OnCancelar="() => eliminando = null" />

@code {
    private List<Proveedor> items = new();
    private Proveedor modelo = new();
    private Proveedor? eliminando;
    private string? buscar;
    private string? errorForm;
    private bool mostrarForm;
    private bool guardando;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        Cargando = true;
        await Ejecutar(async () => items = await Api.GetAsync<List<Proveedor>>(ApiClient.Buscar("api/Proveedores", buscar)));
        Cargando = false;
    }

    private void Nuevo() { modelo = new(); errorForm = null; mostrarForm = true; }
    private void Editar(Proveedor p) { modelo = Clonar(p); errorForm = null; mostrarForm = true; }
    private void Cancelar() => mostrarForm = false;

    private async Task Guardar()
    {
        guardando = true;
        errorForm = null;
        try
        {
            if (modelo.IdProveedor == 0) await Api.PostAsync<Proveedor>("api/Proveedores", modelo);
            else await Api.PutAsync($"api/Proveedores/{modelo.IdProveedor}", modelo);

            mostrarForm = false;
            Exito("Proveedor guardado correctamente.");
            await Cargar();
        }
        catch (ApiException ex) { errorForm = ex.Message; }
        finally { guardando = false; }
    }

    private async Task Eliminar()
    {
        var p = eliminando!;
        eliminando = null;
        if (await Ejecutar(() => Api.DeleteAsync($"api/Proveedores/{p.IdProveedor}"), "Proveedor eliminado."))
            await Cargar();
    }
}
