@page "/clientes"
@attribute [Authorize]
@inherits PaginaBase

<PageTitle>Clientes</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0"><i class="bi bi-people"></i> Clientes</h1>
    <div class="d-flex gap-2">
        <a href="/ventas" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver a Ventas</a>
        <button class="btn btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg"></i> Nuevo cliente</button>
    </div>
</div>

<Alerta Mensaje="@Mensaje" Tipo="@TipoMensaje" OnCerrar="CerrarMensaje" />

<div class="input-group mb-3">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input class="form-control" placeholder="Buscar por nombre, NIT o correo..."
           @bind="buscar" @bind:event="oninput" @bind:after="Cargar" />
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Nombre</th><th>NIT</th><th>Telefono</th><th>Correo</th><th>Direccion</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @if (Cargando)
                {
                    <tr><td colspan="7" class="text-center py-4"><div class="spinner-border spinner-border-sm"></div> Cargando...</td></tr>
                }
                else if (items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">No hay clientes registrados.</td></tr>
                }
                else
                {
                    @foreach (var c in items)
                    {
                        <tr>
                            <td>@c.IdCliente</td>
                            <td>@c.Nombres @c.Apellidos</td>
                            <td>@c.Nit</td>
                            <td>@c.Telefono</td>
                            <td>@c.Correo</td>
                            <td>@c.Direccion</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => Editar(c)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => eliminando = c"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<Modal Visible="mostrarForm" Title="@(modelo.IdCliente == 0 ? "Nuevo cliente" : "Editar cliente")" OnClose="Cancelar">
    @if (errorForm is not null)
    {
        <div class="alert alert-danger">@errorForm</div>
    }
    <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombres *</label>
                <InputText class="form-control" @bind-Value="modelo.Nombres" />
                <ValidationMessage For="() => modelo.Nombres" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Apellidos *</label>
                <InputText class="form-control" @bind-Value="modelo.Apellidos" />
                <ValidationMessage For="() => modelo.Apellidos" />
            </div>
            <div class="col-md-4">
                <label class="form-label">NIT</label>
                <InputText class="form-control" @bind-Value="modelo.Nit" />
                <ValidationMessage For="() => modelo.Nit" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Genero</label>
                <InputSelect class="form-select" @bind-Value="modelo.Genero">
                    <option value="">-- Sin especificar --</option>
                    <option value="true">Masculino</option>
                    <option value="false">Femenino</option>
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label class="form-label">Telefono</label>
                <InputText class="form-control" @bind-Value="modelo.Telefono" />
                <ValidationMessage For="() => modelo.Telefono" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Correo electronico</label>
                <InputText type="email" class="form-control" @bind-Value="modelo.Correo" />
                <ValidationMessage For="() => modelo.Correo" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Direccion</label>
                <InputText class="form-control" @bind-Value="modelo.Direccion" />
                <ValidationMessage For="() => modelo.Direccion" />
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@guardando"><i class="bi bi-save"></i> Guardar</button>
        </div>
    </EditForm>
</Modal>

<ConfirmarEliminar Visible="eliminando is not null" Nombre="@(eliminando is null ? "" : $"{eliminando.Nombres} {eliminando.Apellidos}")"
                   OnConfirmar="Eliminar" OnCancelar="() => eliminando = null" />

@code {
    private List<Cliente> items = new();
    private Cliente modelo = new();
    private Cliente? eliminando;
    private string? buscar;
    private string? errorForm;
    private bool mostrarForm;
    private bool guardando;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        Cargando = true;
        await Ejecutar(async () => items = await Api.GetAsync<List<Cliente>>(ApiClient.Buscar("api/Clientes", buscar)));
        Cargando = false;
    }

    private void Nuevo() { modelo = new(); errorForm = null; mostrarForm = true; }
    private void Editar(Cliente c) { modelo = Clonar(c); errorForm = null; mostrarForm = true; }
    private void Cancelar() => mostrarForm = false;

    private async Task Guardar()
    {
        guardando = true;
        errorForm = null;
        try
        {
            if (modelo.IdCliente == 0) await Api.PostAsync<Cliente>("api/Clientes", modelo);
            else await Api.PutAsync($"api/Clientes/{modelo.IdCliente}", modelo);

            mostrarForm = false;
            Exito("Cliente guardado correctamente.");
            await Cargar();
        }
        catch (ApiException ex) { errorForm = ex.Message; }
        finally { guardando = false; }
    }

    private async Task Eliminar()
    {
        var c = eliminando!;
        eliminando = null;
        if (await Ejecutar(() => Api.DeleteAsync($"api/Clientes/{c.IdCliente}"), "Cliente eliminado."))
            await Cargar();
    }
}
