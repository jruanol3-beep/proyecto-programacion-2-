@page "/marcas"
@attribute [Authorize]
@inherits PaginaBase

<PageTitle>Marcas</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0"><i class="bi bi-tags"></i> Marcas</h1>
    <div class="d-flex gap-2">
        <a href="/productos" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver a Productos</a>
        <button class="btn btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg"></i> Nueva marca</button>
    </div>
</div>

<Alerta Mensaje="@Mensaje" Tipo="@TipoMensaje" OnCerrar="CerrarMensaje" />

<div class="input-group mb-3">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input class="form-control" placeholder="Buscar marca..."
           @bind="buscar" @bind:event="oninput" @bind:after="Cargar" />
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th style="width:70px">#</th><th>Marca</th><th class="text-end" style="width:140px">Acciones</th></tr>
            </thead>
            <tbody>
                @if (Cargando)
                {
                    <tr><td colspan="3" class="text-center py-4"><div class="spinner-border spinner-border-sm"></div> Cargando...</td></tr>
                }
                else if (items.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-secondary py-4">No hay marcas registradas.</td></tr>
                }
                else
                {
                    @foreach (var m in items)
                    {
                        <tr>
                            <td>@m.IdMarca</td>
                            <td>@m.Nombre</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => Editar(m)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => eliminando = m"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<Modal Visible="mostrarForm" Title="@(modelo.IdMarca == 0 ? "Nueva marca" : "Editar marca")" Size="modal-md" OnClose="Cancelar">
    @if (errorForm is not null)
    {
        <div class="alert alert-danger">@errorForm</div>
    }
    <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Marca *</label>
            <InputText class="form-control" @bind-Value="modelo.Nombre" />
            <ValidationMessage For="() => modelo.Nombre" />
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@guardando"><i class="bi bi-save"></i> Guardar</button>
        </div>
    </EditForm>
</Modal>

<ConfirmarEliminar Visible="eliminando is not null" Nombre="@(eliminando?.Nombre ?? "")"
                   OnConfirmar="Eliminar" OnCancelar="() => eliminando = null" />

@code {
    private List<Marca> items = new();
    private Marca modelo = new();
    private Marca? eliminando;
    private string? buscar;
    private string? errorForm;
    private bool mostrarForm;
    private bool guardando;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        Cargando = true;
        await Ejecutar(async () => items = await Api.GetAsync<List<Marca>>(ApiClient.Buscar("api/Marcas", buscar)));
        Cargando = false;
    }

    private void Nuevo() { modelo = new(); errorForm = null; mostrarForm = true; }
    private void Editar(Marca m) { modelo = Clonar(m); errorForm = null; mostrarForm = true; }
    private void Cancelar() => mostrarForm = false;

    private async Task Guardar()
    {
        guardando = true;
        errorForm = null;
        try
        {
            if (modelo.IdMarca == 0) await Api.PostAsync<Marca>("api/Marcas", modelo);
            else await Api.PutAsync($"api/Marcas/{modelo.IdMarca}", modelo);

            mostrarForm = false;
            Exito("Marca guardada correctamente.");
            await Cargar();
        }
        catch (ApiException ex) { errorForm = ex.Message; }
        finally { guardando = false; }
    }

    private async Task Eliminar()
    {
        var m = eliminando!;
        eliminando = null;
        if (await Ejecutar(() => Api.DeleteAsync($"api/Marcas/{m.IdMarca}"), "Marca eliminada."))
            await Cargar();
    }
}
