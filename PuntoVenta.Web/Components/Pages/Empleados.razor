@page "/empleados"
@attribute [Authorize]
@inherits PaginaBase

<PageTitle>Empleados</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0"><i class="bi bi-person-badge"></i> Empleados</h1>
    <div class="d-flex gap-2">
        <a href="/puestos" class="btn btn-outline-secondary"><i class="bi bi-briefcase"></i> Administrar puestos</a>
        <button class="btn btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg"></i> Nuevo empleado</button>
    </div>
</div>

<Alerta Mensaje="@Mensaje" Tipo="@TipoMensaje" OnCerrar="CerrarMensaje" />

<div class="input-group mb-3">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input class="form-control" placeholder="Buscar por nombre, DPI o puesto..."
           @bind="buscar" @bind:event="oninput" @bind:after="Cargar" />
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Nombre</th><th>DPI</th><th>Puesto</th><th>Telefono</th><th>Correo</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @if (Cargando)
                {
                    <tr><td colspan="7" class="text-center py-4"><div class="spinner-border spinner-border-sm"></div> Cargando...</td></tr>
                }
                else if (items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">No hay empleados registrados.</td></tr>
                }
                else
                {
                    @foreach (var e in items)
                    {
                        <tr>
                            <td>@e.IdEmpleado</td>
                            <td>@e.Nombres @e.Apellidos</td>
                            <td>@e.Dpi</td>
                            <td><span class="badge text-bg-secondary">@e.Puesto?.Nombre</span></td>
                            <td>@e.Telefono</td>
                            <td>@e.Correo</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" title="Editar" @onclick="() => Editar(e)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => eliminando = e"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<Modal Visible="mostrarForm" Title="@(modelo.IdEmpleado == 0 ? "Nuevo empleado" : "Editar empleado")" OnClose="Cancelar">
    @if (errorForm is not null)
    {
        <div class="alert alert-danger">@errorForm</div>
    }
    <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombres *</label>
                <InputText class="form-control" @bind-Value="modelo.Nombres" />
                <ValidationMessage For="() => modelo.Nombres" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Apellidos *</label>
                <InputText class="form-control" @bind-Value="modelo.Apellidos" />
                <ValidationMessage For="() => modelo.Apellidos" />
            </div>
            <div class="col-md-6">
                <label class="form-label">DPI *</label>
                <InputText class="form-control" @bind-Value="modelo.Dpi" />
                <ValidationMessage For="() => modelo.Dpi" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Puesto *</label>
                <div class="input-group">
                    <InputSelect class="form-select" @bind-Value="modelo.IdPuesto">
                        <option value="0">-- Seleccione un puesto --</option>
                        @foreach (var p in puestos)
                        {
                            <option value="@p.IdPuesto">@p.Nombre</option>
                        }
                    </InputSelect>
                    <a href="/puestos" target="_blank" class="btn btn-outline-secondary" title="Agregar puesto (abre en otra pestana)">
                        <i class="bi bi-plus-lg"></i> Puestos
                    </a>
                    <button type="button" class="btn btn-outline-secondary" title="Actualizar lista de puestos" @onclick="RecargarPuestos"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <ValidationMessage For="() => modelo.IdPuesto" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Telefono</label>
                <InputText class="form-control" @bind-Value="modelo.Telefono" />
                <ValidationMessage For="() => modelo.Telefono" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Correo electronico</label>
                <InputText type="email" class="form-control" @bind-Value="modelo.Correo" />
                <ValidationMessage For="() => modelo.Correo" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Fecha de nacimiento</label>
                <InputDate class="form-control" @bind-Value="modelo.FechaNacimiento" />
                <ValidationMessage For="() => modelo.FechaNacimiento" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Inicio de labores</label>
                <InputDate class="form-control" @bind-Value="modelo.FechaInicioLabores" />
                <ValidationMessage For="() => modelo.FechaInicioLabores" />
            </div>
            <div class="col-12">
                <label class="form-label">Direccion</label>
                <InputText class="form-control" @bind-Value="modelo.Direccion" />
                <ValidationMessage For="() => modelo.Direccion" />
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@guardando"><i class="bi bi-save"></i> Guardar</button>
        </div>
    </EditForm>
</Modal>

<ConfirmarEliminar Visible="eliminando is not null" Nombre="@(eliminando is null ? "" : $"{eliminando.Nombres} {eliminando.Apellidos}")"
                   OnConfirmar="Eliminar" OnCancelar="() => eliminando = null" />

@code {
    private List<Empleado> items = new();
    private List<Puesto> puestos = new();
    private Empleado modelo = new();
    private Empleado? eliminando;
    private string? buscar;
    private string? errorForm;
    private bool mostrarForm;
    private bool guardando;

    protected override async Task OnInitializedAsync()
    {
        await Ejecutar(async () => puestos = await Api.GetAsync<List<Puesto>>("api/Puestos"));
        await Cargar();
    }

    private async Task RecargarPuestos() =>
        await Ejecutar(async () => puestos = await Api.GetAsync<List<Puesto>>("api/Puestos"));

    private async Task Cargar()
    {
        Cargando = true;
        await Ejecutar(async () => items = await Api.GetAsync<List<Empleado>>(ApiClient.Buscar("api/Empleados", buscar)));
        Cargando = false;
    }

    private void Nuevo()
    {
        modelo = new();
        errorForm = puestos.Count == 0 ? "Primero registre al menos un puesto en el mantenimiento de Puestos." : null;
        mostrarForm = true;
    }

    private void Editar(Empleado e) { modelo = Clonar(e); modelo.Puesto = null; errorForm = null; mostrarForm = true; }
    private void Cancelar() => mostrarForm = false;

    private async Task Guardar()
    {
        errorForm = null;
        if (modelo.FechaNacimiento is DateTime nac && nac.Date >= DateTime.Today)
        {
            errorForm = "La fecha de nacimiento debe ser anterior a hoy.";
            return;
        }
        if (modelo.FechaNacimiento is DateTime n2 && modelo.FechaInicioLabores is DateTime ini && ini.Date < n2.Date)
        {
            errorForm = "El inicio de labores no puede ser anterior al nacimiento.";
            return;
        }

        guardando = true;
        try
        {
            if (modelo.IdEmpleado == 0) await Api.PostAsync<Empleado>("api/Empleados", modelo);
            else await Api.PutAsync($"api/Empleados/{modelo.IdEmpleado}", modelo);

            mostrarForm = false;
            Exito("Empleado guardado correctamente.");
            await Cargar();
        }
        catch (ApiException ex) { errorForm = ex.Message; }
        finally { guardando = false; }
    }

    private async Task Eliminar()
    {
        var e = eliminando!;
        eliminando = null;
        if (await Ejecutar(() => Api.DeleteAsync($"api/Empleados/{e.IdEmpleado}"), "Empleado eliminado."))
            await Cargar();
    }
}
